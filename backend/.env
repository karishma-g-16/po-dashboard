PROJECT_NAME="PO Management Dashboard"
SECRET_KEY="your-super-secret-key-for-jwt-tokens"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL (local setup)
DATABASE_URL="postgresql://postgres:Test123@localhost:5432/podashboard"

# Back to standard Redis URL
REDIS_URL="redis://localhost:6379/0"

# Upload settings
UPLOAD_DIR="uploads"
ALLOWED_EXTENSIONS=["pdf", "png", "jpg", "jpeg", "xlsx", "xls", "csv", "txt"]

# Tesseract OCR path (Windows)
TESSERACT_CMD=r"C:\Program Files\Tesseract-OCR\tesseract.exe"

# Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
